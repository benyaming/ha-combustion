{
  "config": {
    "step": {
      "confirm": {
        "description": "Set up Combustion Inc? Every Combustion probe, Giant Grill Gauge, Display, Booster and Engine in Bluetooth range is added automatically, including probes heard only through MeatNet."
      }
    },
    "abort": {
      "already_configured": "Combustion Inc is already set up.",
      "not_supported": "This Bluetooth advertisement is not from a supported Combustion device."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "active_connection": "Connect for predictions and control"
        },
        "data_description": {
          "active_connection": "Hold one Bluetooth connection to a MeatNet device (or to probes, when no other Combustion device is in range). This adds predictions, food safety, alarm state and controls. Temperatures are read from advertisements either way. Needs a local adapter or an ESPHome Bluetooth proxy; a passive proxy cannot connect."
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "overheating": { "name": "Overheating" },
      "alarm": { "name": "Alarm" },
      "sensor_present": { "name": "Sensor connected" },
      "high_alarm": { "name": "High alarm" },
      "low_alarm": { "name": "Low alarm" },
      "app_mode": { "name": "App mode" },
      "control_device_connected": { "name": "Control device" },
      "lid_open": { "name": "Lid" },
      "fixed_speed": { "name": "Fixed fan speed" },
      "connected": { "name": "Connected" }
    },
    "button": {
      "silence_alarms": { "name": "Silence alarms" }
    },
    "number": {
