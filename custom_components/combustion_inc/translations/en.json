      "message": "The Combustion device rejected the command."
    },
    "command_timeout": {
      "message": "The Combustion device did not answer the command."
    },
    "removal_temperature_required": {
      "message": "Set a removal temperature first."
    },
    "alarm_temperature_required": {
      "message": "Set the alarm temperature first."
    },
